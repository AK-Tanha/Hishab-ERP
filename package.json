{
  "name": "hishab",
  "private": true,
  "description": "Hishab ERP - Multi-tenant ERP for Bangladeshi SMEs",
  "version": "1.0.0",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate:api": "pnpm --filter @hishab/api db:migrate",
    "db:seed:api": "pnpm --filter @hishab/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.2",
    "prettier": "^3.5.3",
    "eslint": "^9.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
