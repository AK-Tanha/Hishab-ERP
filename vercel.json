{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "installCommand": "pnpm install",
      "buildCommand": "pnpm --filter @hishab/api... build"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "pnpm install",
      "buildCommand": "pnpm --filter @hishab/web... build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
