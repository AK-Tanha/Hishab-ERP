{
  "name": "@hishab/api",
  "version": "1.0.0",
  "private": true,
  "description": "Hishab ERP API - NestJS modular monolith",
  "main": "dist/main",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config test/jest-e2e.json",
    "db:migrate": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "db:seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "lint:fix": "eslint 'src/**/*.ts' --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "typeorm": "^0.3.20",
    "pg": "^8.13.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "bcryptjs": "^2.4.3",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@hishab/shared": "workspace:*",
    "zod": "^3.24.1",
    "@nestjs/throttler": "^6.0.0",
    "helmet": "^8.0.0",
    "nestjs-pino": "^4.0.0",
    "@nestjs/terminus": "^11.0.0",
    "nestjs-cls": "^5.0.0",
    "@react-pdf/renderer": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "typescript-eslint": "^8.20.0",
    "@eslint/js": "^9.20.0"
  }
}
