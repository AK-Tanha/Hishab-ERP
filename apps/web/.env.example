# Base URL of the API for browser calls.
# Local dev: http://localhost:3001
# Production (e.g. Vercel): leave unset — the app uses same-origin /api/v1/...
# URLs, routed to the API service via the /api rewrite in vercel.json.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
